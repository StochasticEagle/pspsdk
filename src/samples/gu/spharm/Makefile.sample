TARGET = spharm
OBJS = cube.o spharm.o disablefpu.o mt19937.o logo.o logo2.o logo3.o

INCDIR =
CFLAGS = -Wall -fno-exceptions
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS = $(CFLAGS)

LIBDIR =
LDFLAGS =
LIBS= -lpspgum -lpspgu

EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = adresd - spharm v1.0

PSPSDK=$(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak

# Declare the generated object dependencies explicitly so parallel builds are safe.
logo.o: logo.raw
	bin2o -i $< $@ logo

logo2.o: Image1.raw
	bin2o -i $< $@ logo2

logo3.o: Image2.raw
	bin2o -i $< $@ logo3

convlogo: logo.o logo2.o logo3.o

copyms:
	cp -f EBOOT.PBP /cygdrive/I/PSP/GAME/SPHARM
